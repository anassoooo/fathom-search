                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "subcategory",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Subcategory"
            }
          },
          {
            "in": "query",
            "name": "price_min",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Min"
            }
          },
          {
            "in": "query",
            "name": "price_max",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Max"
            }
          },
          {
            "in": "query",
            "name": "price_bucket",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "cheap",
                    "mid",
                    "premium"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Bucket"
            }
          },
          {
            "in": "query",
            "name": "min_rating",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 5,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Rating"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
