          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "price": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "price_bucket": {
            "anyOf": [
              {
                "enum": [
                  "cheap",
                  "mid",
                  "premium"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Bucket"
          },
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "quality_flags": {
            "items": {
              "type": "string"
            },
            "title": "Quality Flags",
            "type": "array"
          },
          "rating": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "raw_categories": {
            "items": {
              "type": "string"
            },
            "title": "Raw Categories",
            "type": "array"
          },
          "subcategories": {
            "items": {
              "type": "string"
            },
            "title": "Subcategories",
            "type": "array"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          },
          "total_ratings": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
