    "/v1/taxonomy": {
      "get": {
        "operationId": "taxonomy_v1_taxonomy_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxonomyOut"
