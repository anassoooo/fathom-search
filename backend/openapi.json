              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "min_rating": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Rating"
          },
          "price_bucket": {
            "anyOf": [
              {
                "enum": [
                  "cheap",
                  "mid",
                  "premium"
