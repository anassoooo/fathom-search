      "SearchHit": {
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "product",
          "score",
          "rank"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "image_b64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image B64"
