          "query": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "variant": {
            "default": "hybrid_rerank",
            "enum": [
              "bm25",
              "dense",
              "hybrid",
              "hybrid_rerank",
              "full"
            ],
            "title": "Variant",
            "type": "string"
          }
        },
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "applied_filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "boosted_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Boosted Category"
          },
          "degraded": {
            "items": {
              "type": "string"
            },
            "title": "Degraded",
            "type": "array"
          },
          "dropped_filters": {
            "items": {
              "type": "string"
            },
            "title": "Dropped Filters",
            "type": "array"
          },
          "parsed_query": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parsed Query"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "title": "Results",
            "type": "array"
