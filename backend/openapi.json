          },
          "variant": {
            "enum": [
              "bm25",
              "dense",
              "hybrid",
              "hybrid_rerank",
              "full"
            ],
            "title": "Variant",
            "type": "string"
          }
        },
        "required": [
          "results",
          "variant",
          "applied_filters"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SimilarOut": {
        "properties": {
          "product_id": {
            "title": "Product Id",
            "type": "string"
          },
          "results": {
            "items": {
