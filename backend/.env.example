# VIO backend configuration.
#
# Setup:  copy this file to `backend/.env`, then replace the one placeholder below
#         (LLM_API_KEY) with your Groq key from https://console.groq.com/keys
#         Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env
#
# `.env` is gitignored: never commit it, never paste the key into chat or code.
# Every other value already works with `docker compose up -d qdrant` and Groq.

# ---------------------------------------------------------------------------
# LLM (Groq, OpenAI-compatible API)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=paste-your-groq-key-here
# Models available on Groq change over time: check https://console.groq.com/docs/models
# Serving: query understanding (fast) and the assistant
LLM_MODEL_QUERY=openai/gpt-oss-20b
LLM_MODEL_AGENT=openai/gpt-oss-120b
# Offline eval: query generation + relevance judge (strongest available)
LLM_MODEL_EVAL=openai/gpt-oss-120b
# gpt-oss models reason before answering; "low" keeps runs inside free-tier
# tokens-per-minute limits (8K TPM on the free plan as of 2026-10). Leave empty for others.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=30
# To use a local Ollama instead:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL_QUERY=qwen2.5:3b-instruct   (and the same for the other model lines)

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vio_products_v2

# ---------------------------------------------------------------------------
# Models (fastembed / ONNX Runtime)
# ---------------------------------------------------------------------------
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
CLIP_TEXT_MODEL=Qdrant/clip-ViT-B-32-text
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=30
RERANK_TIMEOUT_S=2
# cpu | cuda. `cuda` needs the GPU build: `uv sync --group gpu` (see backend/README.md)
ONNX_DEVICE=cpu
# CPU threads per model (all cores oversubscribes; 4 was fastest on a 16-thread laptop)
ONNX_THREADS=4
# Where fastembed caches downloaded models (empty = system temp dir)
MODEL_CACHE_DIR=

# ---------------------------------------------------------------------------
# Observability (Langfuse is optional; leave empty to disable)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
