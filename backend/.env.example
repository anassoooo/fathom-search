# Copy to .env and fill in. Every variable is optional; defaults target local docker compose + Ollama.

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vio_products_v2

# LLM: any OpenAI-compatible endpoint.
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
#   Groq:           LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=<your key>
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_QUERY=qwen2.5:3b-instruct
LLM_MODEL_AGENT=qwen2.5:3b-instruct
# Model for offline eval (query generation + relevance judge); Groq example below
LLM_MODEL_EVAL=llama-3.3-70b-versatile
LLM_TIMEOUT_S=30

# Models
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
CLIP_TEXT_MODEL=Qdrant/clip-ViT-B-32-text
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Where fastembed caches downloaded ONNX models (empty = system temp dir)
MODEL_CACHE_DIR=
# ONNX Runtime threads per model (all cores oversubscribes; 4 was fastest on a 16-thread laptop)
ONNX_THREADS=4
RERANK_TOP_N=30
RERANK_TIMEOUT_S=2

# Observability (Langfuse is optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# API
CORS_ORIGINS=["http://localhost:3000"]
