# Copy to web/.env for local development (gitignored).
# Postgres from the repo's docker-compose.yml (`docker compose up -d postgres`).
DATABASE_URL="postgresql://vio:vio@localhost:5434/vio"
# The Python search backend (`cd backend && uv run vio serve`).
BACKEND_URL="http://127.0.0.1:8000"
# Signs session cookies; generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
